TERRAFORM_VERSION=latest
K9S_VERSION=latest
ARGOCD_VERSION=latest
FLUX2_VERSION=latest
YQ_VERSION=latest
JQ_VERSION=latest
GO_VERSION=latest
PYTHON_VERSION=3.12
